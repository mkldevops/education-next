# App
PORT=8550
NEXT_PUBLIC_APP_URL=http://localhost:${PORT}
# Reverse proxies in front of the app; `x-forwarded-for` is trusted only from the right.
# 0 disables per-IP rate-limit buckets (all pre-auth traffic shares one counter).
TRUSTED_PROXY_HOPS=1

# Docker Ports
PORT_POSTGRES=8551
PORT_MAILPIT_SMTP=8552
PORT_MAILPIT_WEB=8553

# Database
DATABASE_URL=postgresql://app:password@localhost:8551/app

# BetterAuth
BETTER_AUTH_SECRET=your-secret-key
BETTER_AUTH_URL=http://localhost:${PORT}

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email
# resend | brevo | mailpit (mailpit delivers to the local Docker inbox, dev only)
EMAIL_PROVIDER=mailpit
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=Newsletter
ADMIN_EMAIL=admin@example.com
MAILPIT_URL=http://localhost:8553
RESEND_API_KEY=re_xxx

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Plane (Project Management)
PLANE_TOKEN=plane_api_xxx
PLANE_PROJECT=https://plane.example.com/workspace/projects/project-id/issues/
