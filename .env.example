# App
PORT=8550
NEXT_PUBLIC_APP_URL=http://localhost:${PORT}
# Reverse proxies in front of the app that APPEND to `x-forwarded-for`
# (nginx `$proxy_add_x_forwarded_for`). Accepted range 0..4; anything else falls back to 1.
# The header is trusted only from the right, so the count must be EXACT: too low buckets every
# caller behind the outermost proxy together, too high lets a caller pad the chain and pick its own
# bucket again. `x-real-ip` is not read. 0 = one shared counter for all pre-auth traffic, which caps
# passkey authentication at 10/min for the whole instance.
TRUSTED_PROXY_HOPS=1

# Docker Ports
PORT_POSTGRES=8551
PORT_MAILPIT_SMTP=8552
PORT_MAILPIT_WEB=8553

# Database
DATABASE_URL=postgresql://app:password@localhost:8551/app

# BetterAuth
BETTER_AUTH_SECRET=your-secret-key
BETTER_AUTH_URL=http://localhost:${PORT}

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email
# resend | brevo | mailpit (mailpit delivers to the local Docker inbox, dev only)
EMAIL_PROVIDER=mailpit
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=Newsletter
ADMIN_EMAIL=admin@example.com
MAILPIT_URL=http://localhost:8553
RESEND_API_KEY=re_xxx

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Plane (Project Management)
PLANE_TOKEN=plane_api_xxx
PLANE_PROJECT=https://plane.example.com/workspace/projects/project-id/issues/

# Secrets at rest (OpenRouter key in PlatformSetting)
# 32 bytes, hex (64 chars) or base64. Generate: openssl rand -hex 32
SETTINGS_ENCRYPTION_KEY=

# Enrollment assistant (optional, must be one of AI_ASSISTANT_MODELS in src/domain/ai-assistant.ts)
# AI_ASSISTANT_MODEL=google/gemini-2.5-flash
