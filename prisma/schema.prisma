generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum Sex {
  MALE
  FEMALE
}

enum RelationType {
  PARENT
  TUTOR
  GRANDPARENT
  SIBLING
  OTHER
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum AttendanceSessionStatus {
  DRAFT
  VALIDATED
  CANCELLED
}

enum AttendanceEntryStatus {
  NOT_RECORDED
  PRESENT
  LATE
  ABSENT
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  CHECK
  STRIPE
  MOBILE_MONEY
}

enum MealService {
  CANTEEN
  SNACK
}

/// Écriture en jours sur un compte repas (R10). `OPENING` reprend le cahier : « déjà payé
/// jusqu'au » converti en jours servis.
enum MealAdjustmentKind {
  OPENING
  REFUND
  FORFEIT
  GIFT
}

enum PaymentProvider {
  STRIPE
}

enum PaymentTransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
  EXPIRED
  REFUNDED
}

enum ConfigValueType {
  TEXT
  NUMBER
  BOOLEAN
  COLOR
}

// Rôle porté par une appartenance à une école. SUPER_ADMIN n'en fait pas partie :
// c'est un niveau plateforme, matérialisé par User.isSuperAdmin.
enum SchoolRole {
  ADMIN
  PARENT
  TEACHER
  CASHIER
}

// Nature de l'événement : purement présentationnelle (icône, couleur, filtre).
// La confidentialité vit dans `EventVisibility`, jamais ici : un axe unique évite
// qu'un admin croie restreindre l'audience en choisissant une catégorie.
enum EventCategory {
  MEETING
  TERM_START
  OUTING
  HOLIDAY
  CLOSURE
  CELEBRATION
  OTHER
}

// Échelle ORDONNÉE, du plus large au plus restreint : PUBLIC ⊂ MEMBERS ⊂ STAFF.
// `src/domain/event.ts` la traduit en une liste de visibilités lisibles par un
// lecteur donné, ce qui remplace une matrice audience × catégorie.
//
// Aucune valeur `TEACHER` : `Teacher` ne porte pas de compte et `SchoolRole` n'a que
// `ADMIN` et `PARENT`, donc une audience enseignant serait inatteignable.
enum EventVisibility {
  PUBLIC
  MEMBERS
  STAFF
}

// `CANCELLED` n'est pas un archivage : une sortie annulée reste affichée, barrée.
// Les familles ont déjà organisé leur journée autour d'elle.
enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

// ─── Tenant ─────────────────────────────────────────────────────────────────

model School {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(250)
  slug      String   @unique @db.VarChar(80)
  address   String?  @db.VarChar(250)
  postCode  String?  @db.VarChar(10)
  city      String?  @db.VarChar(250)
  /// Code ISO 4217 des montants de l'école ; une devise sans décimales (KMF) impose des entiers.
  currency  String   @default("EUR") @db.VarChar(3)
  /// Fuseau IANA de l'école : « aujourd'hui », dates d'effet et caisse du jour s'y lisent.
  timeZone  String   @default("Europe/Paris") @db.VarChar(64)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members                   SchoolMember[]
  families                  Family[]
  userFamilies              UserFamily[]
  persons                   Person[]
  familyPersons             FamilyPerson[]
  students                  Student[]
  phoneNumbers              PhoneNumber[]
  configs                   Config[]
  levels                    Level[]
  levelProgressions         LevelProgression[]
  periods                   Period[]
  classPeriods              ClassPeriod[]
  enrollments               Enrollment[]
  classAssignments          ClassAssignment[]
  payments                  Payment[]
  paymentTransactions       PaymentTransaction[]
  plans                     Plan[]
  invitations               Invitation[]
  teachers                  Teacher[]
  classPeriodTeachers       ClassPeriodTeacher[]
  classScheduleSlots        ClassScheduleSlot[]
  classScheduleSlotTeachers ClassScheduleSlotTeacher[]
  teacherExpenses           TeacherExpense[]
  mcpApiKeys                McpApiKey[]
  mcpOAuthGrants            McpOAuthGrant[]
  mcpDrafts                 McpDraft[]
  aiConversations           AiConversation[]
  events                    Event[]
  eventImages               EventImage[]
  attendanceSessions        AttendanceSession[]
  attendanceEntries         AttendanceEntry[]
  absenceReasons            AbsenceReason[]
  mealServiceSettings      MealServiceSetting[]
  mealPrices                MealPrice[]
  mealAccounts              MealAccount[]
  mealSchedules             MealSchedule[]
  mealAdjustments           MealAdjustment[]
  mealAbsences              MealAbsence[]
  receipts                  Receipt[]
  receiptCounter            ReceiptCounter?
  mealPayments              MealPayment[]
  childcareSubscriptions    ChildcareSubscription[]
  childcareCharges          ChildcareCharge[]
  childcarePayments         ChildcarePayment[]
}

// Hors garde tenant par construction : le contexte doit lire les appartenances
// par userId avant de connaître une école. Accès via school-member-gateway.
// `roles` n'est jamais vide (CHECK en base) et sans doublon (normalisé par la passerelle) : un
// compte cumule les droits de chacun de ses rôles dans l'école, enseignant et parent par exemple.
model SchoolMember {
  userId    String
  schoolId  String
  roles     SchoolRole[]
  createdAt DateTime     @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userFamilies UserFamily[]

  @@id([userId, schoolId])
  @@unique([userId, schoolId])
  @@index([schoolId])
}

// ─── Better Auth Models ─────────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  isSuperAdmin  Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  /// « Plus tard » sur la proposition Google / clé d'accès après connexion par mot de passe.
  /// En base et non en cookie : le refus doit suivre l'utilisateur sur tous ses appareils.
  signInUpgradeDismissedAt DateTime?

  /// Dernière consultation des nouveautés de la plateforme (Directus central). Une annonce publiée
  /// après cette date est « nouvelle » ; `null` se lit comme `createdAt`.
  announcementsSeenAt DateTime?

  /// Blocs de l'accueil admin masqués par l'utilisateur (clés de `HOME_WIDGETS`). En base pour
  /// suivre l'utilisateur sur tous ses appareils.
  dashboardHiddenWidgets    String[] @default([])
  /// Vue du graphique d'encaissements de l'accueil admin (`day`, `month`, `year`) et sa période
  /// (`7d`, `30d`, `3m`, `6m`, `12m`). Nulle : vue par défaut, mois sur douze mois.
  dashboardChartGranularity String?
  dashboardChartRange       String?

  sessions                  Session[]
  accounts                  Account[]
  families                  UserFamily[]
  createdFamilies           Family[]                @relation("createdBy")
  createdInvitations        Invitation[]
  paymentTransactions       PaymentTransaction[]    @relation("paymentInitiatedBy")
  passkeys                  Passkey[]
  schoolMemberships         SchoolMember[]
  mcpApiKeys                McpApiKey[]
  mcpOAuthGrants            McpOAuthGrant[]
  aiConversations           AiConversation[]
  teacherProfiles           Teacher[]
  createdAttendanceSessions AttendanceSession[]     @relation("attendanceCreatedBy")
  updatedAttendanceSessions AttendanceSession[]     @relation("attendanceUpdatedBy")
  recordedMealAdjustments   MealAdjustment[]        @relation("mealAdjustmentRecordedBy")
  recordedMealAbsences      MealAbsence[]           @relation("mealAbsenceRecordedBy")
  recordedReceipts          Receipt[]               @relation("receiptRecordedBy")
  cancelledReceipts         Receipt[]               @relation("receiptCancelledBy")
  recordedChildcareCharges  ChildcareCharge[]       @relation("childcareChargeRecordedBy")
  cancelledChildcareCharges ChildcareCharge[]       @relation("childcareChargeCancelledBy")
  childcareOpenings         ChildcareSubscription[] @relation("childcareOpeningRecordedBy")
  cancelledPayments         Payment[]               @relation("paymentCancelledBy")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Super-admin à l'origine d'une session empruntée, posé par le plugin `impersonation`.
  impersonatedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([impersonatedBy])
}

/// Trace durable d'un emprunt d'identité : qui, qui est emprunté, début, fin.
/// Aucune relation vers `User`, volontairement : la trace doit survivre à la suppression
/// des comptes et ne jamais bloquer celle-ci. Les adresses sont figées au démarrage.
model ImpersonationLog {
  id          String    @id @default(cuid())
  actorId     String
  actorEmail  String
  targetId    String
  targetEmail String
  /// `Session.id` de la session empruntée, qui clôt la trace à l'arrêt.
  sessionId   String    @unique
  ipAddress   String?
  userAgent   String?
  startedAt   DateTime  @default(now())
  /// Échéance de la session empruntée : borne la fin si l'arrêt n'est jamais demandé.
  expiresAt   DateTime
  /// Arrêt explicite ou déconnexion ; `null` tant que la session n'a pas été close.
  endedAt     DateTime?

  @@index([actorId])
  @@index([targetId])
  @@index([startedAt])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String   @unique
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ─── Domain Models ──────────────────────────────────────────────────────────

model Family {
  id                    String   @id @default(uuid())
  schoolId              String
  name                  String   @db.VarChar(50)
  emergencyContactName  String?  @db.VarChar(250)
  emergencyContactPhone String?  @db.VarChar(20)
  authorizedPickup      String?  @db.Text
  languagesAtHome       Json     @default("[]")
  createdById           String
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  school              School               @relation(fields: [schoolId], references: [id])
  createdBy           User                 @relation("createdBy", fields: [createdById], references: [id])
  users               UserFamily[]
  persons             FamilyPerson[]
  payments            Payment[]
  paymentTransactions PaymentTransaction[]
  invitations         Invitation[]
  receipts            Receipt[]

  @@unique([id, schoolId])
  @@index([createdById])
  @@index([schoolId])
}

model UserFamily {
  userId   String
  familyId String
  schoolId String

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School       @relation(fields: [schoolId], references: [id])
  family Family       @relation(fields: [familyId, schoolId], references: [id, schoolId], onDelete: Cascade)
  member SchoolMember @relation(fields: [userId, schoolId], references: [userId, schoolId], onDelete: Cascade)

  @@id([userId, familyId])
  @@index([familyId])
  @@index([schoolId])
}

model Person {
  id        String   @id @default(uuid())
  schoolId  String
  name      String   @db.VarChar(250)
  lastname  String   @db.VarChar(250)
  sex       Sex?
  email     String?  @db.VarChar(250)
  address   String?  @db.VarChar(250)
  postCode  String?  @db.VarChar(10)
  city      String?  @db.VarChar(250)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school       School         @relation(fields: [schoolId], references: [id])
  phoneNumbers PhoneNumber[]
  families     FamilyPerson[]
  student      Student?
  invitations  Invitation[]

  @@unique([id, schoolId])
  @@index([schoolId])
}

model FamilyPerson {
  familyId     String
  personId     String
  schoolId     String
  relationType RelationType

  school School @relation(fields: [schoolId], references: [id])
  family Family @relation(fields: [familyId, schoolId], references: [id, schoolId], onDelete: Cascade)
  person Person @relation(fields: [personId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@id([familyId, personId])
  @@index([personId])
  @@index([schoolId])
}

model Student {
  id                 String    @id @default(uuid())
  schoolId           String
  personId           String
  birthday           DateTime?
  birthplace         String?   @db.VarChar(250)
  previousSchool     String?   @db.VarChar(250)
  healthNotes        String?   @db.Text
  snackAuthorization Boolean   @default(false)
  allergies          String?   @db.VarChar(250)
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  school                 School                  @relation(fields: [schoolId], references: [id])
  person                 Person                  @relation(fields: [personId, schoolId], references: [id, schoolId], onDelete: Cascade)
  enrollments            Enrollment[]
  attendanceEntries      AttendanceEntry[]
  mealAccounts           MealAccount[]
  childcareSubscriptions ChildcareSubscription[]

  @@unique([id, schoolId])
  @@unique([personId, schoolId])
  @@index([schoolId])
}

model PhoneNumber {
  id          String   @id @default(uuid())
  schoolId    String
  personId    String
  phoneNumber String   @db.VarChar(20)
  channels    Json     @default("[]")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id])
  person Person @relation(fields: [personId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@index([personId])
  @@index([schoolId])
}

model Config {
  id        String          @id @default(uuid())
  schoolId  String
  name      String          @db.VarChar(250)
  value     String          @db.Text
  valueType ConfigValueType
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  school School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, name], where: { isActive: true })
  @@index([name])
  @@index([schoolId])
}

// Réglage de la plateforme entière, sans école. Volontairement distinct de `Config` :
// celui-ci porte un `schoolId` obligatoire et appartient au garde tenant, donc une
// lecture racine plateforme y lèverait `TenantScopeError`. Pas de `isActive` non plus —
// un réglage plateforme n'a pas de parcours d'archivage, et un `@unique` total sur
// `name` bloquerait la recréation d'un réglage archivé homonyme.
model PlatformSetting {
  id        String          @id @default(uuid())
  name      String          @unique @db.VarChar(250)
  value     String          @db.Text
  valueType ConfigValueType
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model Level {
  id        String   @id @default(uuid())
  schoolId  String
  name      String   @db.VarChar(250)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school         School             @relation(fields: [schoolId], references: [id])
  nextLevels     LevelProgression[] @relation("levelProgressionFrom")
  previousLevels LevelProgression[] @relation("levelProgressionTo")
  classPeriods   ClassPeriod[]

  @@unique([id, schoolId])
  @@unique([schoolId, name], where: { isActive: true })
  @@index([schoolId])
}

/// Arête de la progression : un niveau peut mener à plusieurs niveaux, et un niveau peut
/// suivre plusieurs niveaux. Le graphe reste sans cycle (`setNextLevels`).
model LevelProgression {
  schoolId    String
  levelId     String
  nextLevelId String
  createdAt   DateTime @default(now())

  school    School @relation(fields: [schoolId], references: [id])
  level     Level  @relation("levelProgressionFrom", fields: [levelId, schoolId], references: [id, schoolId], onDelete: Cascade)
  nextLevel Level  @relation("levelProgressionTo", fields: [nextLevelId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@id([levelId, nextLevelId])
  @@index([nextLevelId])
  @@index([schoolId])
}

model Period {
  id        String   @id @default(uuid())
  schoolId  String
  name      String   @db.VarChar(50)
  startAt   DateTime
  endAt     DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school        School         @relation(fields: [schoolId], references: [id])
  classPeriods  ClassPeriod[]
  mealSchedules MealSchedule[]

  @@unique([id, schoolId])
  @@unique([schoolId, name], where: { isActive: true })
  @@index([schoolId])
}

model ClassPeriod {
  id        String   @id @default(uuid())
  schoolId  String
  name      String   @db.VarChar(250)
  capacity  Int
  levelId   String
  periodId  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school             School               @relation(fields: [schoolId], references: [id])
  level              Level                @relation(fields: [levelId, schoolId], references: [id, schoolId], onDelete: Restrict)
  period             Period               @relation(fields: [periodId, schoolId], references: [id, schoolId], onDelete: Restrict)
  classAssignments   ClassAssignment[]
  teachers           ClassPeriodTeacher[]
  scheduleSlots      ClassScheduleSlot[]
  attendanceSessions AttendanceSession[]

  @@unique([id, schoolId])
  @@index([levelId])
  @@index([periodId])
  @@index([schoolId])
}

model Teacher {
  id         String   @id @default(uuid())
  schoolId   String
  userId     String?
  firstName  String   @db.VarChar(250)
  lastName   String   @db.VarChar(250)
  email      String?  @db.VarChar(250)
  phone      String?  @db.VarChar(20)
  isActive   Boolean  @default(true)
  mealExempt Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  school        School                     @relation(fields: [schoolId], references: [id])
  user          User?                      @relation(fields: [userId], references: [id], onDelete: SetNull)
  classPeriods  ClassPeriodTeacher[]
  scheduleSlots ClassScheduleSlotTeacher[]
  expenses      TeacherExpense[]
  invitations   Invitation[]
  mealAccounts  MealAccount[]
  receipts      Receipt[]

  @@unique([id, schoolId])
  @@unique([userId, schoolId])
  @@index([userId])
  @@index([schoolId])
  @@index([schoolId, lastName, firstName])
}

model ClassPeriodTeacher {
  schoolId      String
  classPeriodId String
  teacherId     String
  assignedAt    DateTime @default(now())

  school      School      @relation(fields: [schoolId], references: [id])
  classPeriod ClassPeriod @relation(fields: [classPeriodId, schoolId], references: [id, schoolId], onDelete: Cascade)
  teacher     Teacher     @relation(fields: [teacherId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@id([classPeriodId, teacherId])
  @@index([teacherId])
  @@index([schoolId])
}

/// Créneau récurrent de l'emploi du temps d'une classe. Les heures sont des heures
/// murales ISO `HH:mm` car le créneau revient chaque semaine, sans date ni fuseau UTC.
model ClassScheduleSlot {
  id            String   @id @default(uuid())
  schoolId      String
  classPeriodId String
  weekday       Int
  startTime     String   @db.VarChar(5)
  endTime       String   @db.VarChar(5)
  description   String?  @db.VarChar(500)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  school             School                     @relation(fields: [schoolId], references: [id])
  classPeriod        ClassPeriod                @relation(fields: [classPeriodId, schoolId], references: [id, schoolId], onDelete: Cascade)
  teachers           ClassScheduleSlotTeacher[]
  attendanceSessions AttendanceSession[]

  @@unique([id, schoolId])
  @@index([schoolId])
  @@index([schoolId, classPeriodId, weekday, startTime])
}

/// Sous-ensemble des enseignants affectés à la classe (`ClassPeriodTeacher`) pour un
/// créneau. La règle d'appartenance à la classe est revalidée par le cas d'usage.
model ClassScheduleSlotTeacher {
  schoolId            String
  classScheduleSlotId String
  teacherId           String

  school            School            @relation(fields: [schoolId], references: [id])
  classScheduleSlot ClassScheduleSlot @relation(fields: [classScheduleSlotId, schoolId], references: [id, schoolId], onDelete: Cascade)
  teacher           Teacher           @relation(fields: [teacherId, schoolId], references: [id, schoolId], onDelete: Restrict)

  @@id([classScheduleSlotId, teacherId])
  @@index([schoolId])
  @@index([schoolId, teacherId])
}

model TeacherExpense {
  id          String    @id @default(uuid())
  schoolId    String
  teacherId   String
  amount      Decimal   @db.Decimal(10, 2)
  category    String    @db.VarChar(100)
  description String    @db.VarChar(250)
  requestedAt DateTime  @default(now())
  paidAt      DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  school  School  @relation(fields: [schoolId], references: [id])
  teacher Teacher @relation(fields: [teacherId, schoolId], references: [id, schoolId], onDelete: Restrict)

  @@unique([id, schoolId])
  @@index([teacherId])
  @@index([schoolId])
  @@index([requestedAt])
}

model Enrollment {
  id            String           @id @default(uuid())
  schoolId      String
  studentId     String
  planId        String
  status        EnrollmentStatus @default(PENDING)
  totalAmount   Decimal          @db.Decimal(10, 2)
  discount      Decimal          @default(0) @db.Decimal(10, 2)
  registeredAt  DateTime         @default(now())
  /// First month the enrollment owes installments (first day, UTC). Null: the period start.
  startMonth    DateTime?        @db.Date
  canLeaveAlone Boolean          @default(false)
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  school           School            @relation(fields: [schoolId], references: [id])
  student          Student           @relation(fields: [studentId, schoolId], references: [id, schoolId], onDelete: Restrict)
  plan             Plan              @relation(fields: [planId, schoolId], references: [id, schoolId], onDelete: Restrict)
  classAssignments ClassAssignment[]
  payments         Payment[]

  @@unique([id, schoolId])
  @@index([studentId])
  @@index([planId])
  @@index([status])
  @@index([schoolId])
}

model ClassAssignment {
  id            String    @id @default(uuid())
  schoolId      String
  enrollmentId  String
  classPeriodId String
  startAt       DateTime  @default(now())
  endAt         DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  school      School      @relation(fields: [schoolId], references: [id])
  enrollment  Enrollment  @relation(fields: [enrollmentId, schoolId], references: [id, schoolId], onDelete: Restrict)
  classPeriod ClassPeriod @relation(fields: [classPeriodId, schoolId], references: [id, schoolId], onDelete: Restrict)

  @@index([enrollmentId])
  @@index([classPeriodId])
  @@index([schoolId])
}

model AttendanceSession {
  id                       String                   @id @default(uuid())
  schoolId                 String
  classPeriodId            String
  classScheduleSlotId      String?
  occurrenceKey            String                   @db.VarChar(300)
  occurredOn               DateTime                 @db.Date
  status                   AttendanceSessionStatus  @default(DRAFT)
  statusBeforeCancellation AttendanceSessionStatus?
  createdById              String
  updatedById              String
  validatedAt              DateTime?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  school            School             @relation(fields: [schoolId], references: [id])
  classPeriod       ClassPeriod        @relation(fields: [classPeriodId, schoolId], references: [id, schoolId], onDelete: Restrict)
  classScheduleSlot ClassScheduleSlot? @relation(fields: [classScheduleSlotId, schoolId], references: [id, schoolId], onDelete: Restrict)
  createdBy         User               @relation("attendanceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy         User               @relation("attendanceUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  entries           AttendanceEntry[]

  @@unique([id, schoolId])
  @@unique([schoolId, classPeriodId, occurredOn, occurrenceKey], map: "AttendanceSession_occurrence_key")
  @@index([schoolId, occurredOn])
}

model AttendanceEntry {
  id                  String                @id @default(uuid())
  schoolId            String
  attendanceSessionId String
  studentId           String
  studentName         String                @db.VarChar(500)
  status              AttendanceEntryStatus @default(NOT_RECORDED)
  lateMinutes         Int?
  message             String?               @db.VarChar(1000)
  /// Motif d'une absence ; vidé dès que l'élève n'est plus ABSENT.
  absenceReasonId     String?
  /// Libellé figé à la saisie : renommer ou archiver le motif ne réécrit pas un appel passé.
  absenceReasonLabel  String?               @db.VarChar(80)
  updatedById         String
  updatedAt           DateTime              @updatedAt

  school            School            @relation(fields: [schoolId], references: [id])
  attendanceSession AttendanceSession @relation(fields: [attendanceSessionId, schoolId], references: [id, schoolId], onDelete: Cascade)
  student           Student           @relation(fields: [studentId, schoolId], references: [id, schoolId], onDelete: Restrict)
  absenceReason     AbsenceReason?    @relation(fields: [absenceReasonId, schoolId], references: [id, schoolId], onDelete: Restrict)

  @@unique([attendanceSessionId, studentId])
  @@index([schoolId, studentId])
}

/// Motif d'absence proposé à l'appel, géré par l'école. Archivé plutôt que supprimé : les
/// appels passés le référencent.
model AbsenceReason {
  id        String   @id @default(uuid())
  schoolId  String
  label     String   @db.VarChar(80)
  justified Boolean  @default(false)
  position  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school            School            @relation(fields: [schoolId], references: [id])
  attendanceEntries AttendanceEntry[]

  @@unique([id, schoolId])
  @@index([schoolId, position])
}

model Payment {
  id                   String        @id @default(uuid())
  schoolId             String
  familyId             String
  enrollmentId         String
  paymentTransactionId String?
  receiptId            String?
  amount               Decimal       @db.Decimal(10, 2)
  method               PaymentMethod
  reference            String?       @db.VarChar(250)
  paidAt               DateTime
  cashedAt             DateTime?
  isActive             Boolean       @default(true)
  /// Annulation d'une saisie manuelle (`cancelPayments`) : qui, quand et pourquoi. Un règlement
  /// désactivé par l'annulation de son reçu ne la porte pas : le reçu garde la sienne.
  cancelledAt          DateTime?
  cancelledById        String?
  cancelReason         String?       @db.VarChar(250)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  school             School              @relation(fields: [schoolId], references: [id])
  cancelledBy        User?               @relation("paymentCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  family             Family              @relation(fields: [familyId, schoolId], references: [id, schoolId], onDelete: Restrict)
  enrollment         Enrollment          @relation(fields: [enrollmentId, schoolId], references: [id, schoolId], onDelete: Restrict)
  paymentTransaction PaymentTransaction? @relation(fields: [paymentTransactionId, schoolId], references: [id, schoolId], onDelete: Restrict)
  receipt            Receipt?            @relation(fields: [receiptId, schoolId], references: [id, schoolId], onDelete: Restrict)

  @@index([familyId])
  @@index([enrollmentId])
  @@index([paymentTransactionId])
  @@index([receiptId])
  @@index([schoolId])
}

model PaymentTransaction {
  id                String                   @id @default(uuid())
  schoolId          String
  familyId          String
  initiatedById     String
  amount            Decimal                  @db.Decimal(10, 2)
  currency          String                   @default("EUR") @db.VarChar(3)
  provider          PaymentProvider
  status            PaymentTransactionStatus @default(PENDING)
  providerSessionId String?                  @unique
  providerPaymentId String?                  @db.VarChar(250)
  succeededAt       DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  school      School                 @relation(fields: [schoolId], references: [id])
  family      Family                 @relation(fields: [familyId, schoolId], references: [id, schoolId], onDelete: Restrict)
  initiatedBy User                   @relation("paymentInitiatedBy", fields: [initiatedById], references: [id])
  allocations Payment[]
  events      PaymentProviderEvent[]

  @@unique([id, schoolId])
  @@index([familyId])
  @@index([initiatedById])
  @@index([status])
  @@index([schoolId])
}

// Non scopé volontairement : paymentTransactionId est nullable, un événement
// fournisseur orphelin n'a aucune école dérivable. Journal plateforme, écrit
// uniquement dans le chemin d'exception Stripe.
model PaymentProviderEvent {
  id                   String   @id @default(uuid())
  providerEventId      String   @unique
  type                 String   @db.VarChar(100)
  paymentTransactionId String?
  createdAt            DateTime @default(now())

  paymentTransaction PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id])

  @@index([paymentTransactionId])
}

model Plan {
  id              String   @id @default(uuid())
  schoolId        String
  name            String   @db.VarChar(50)
  amount          Decimal  @db.Decimal(10, 2)
  pricing         Json?
  paymentSchedule Json?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  school      School       @relation(fields: [schoolId], references: [id])
  enrollments Enrollment[]

  @@unique([id, schoolId])
  @@unique([schoolId, name], where: { isActive: true })
  @@index([schoolId])
}

/// Réglage d'un service repas pour une école. Les jours autorisés (ISO, lundi = 1) ne
/// valident que la saisie des jours d'un enfant : les changer ne recalcule aucun passé.
model MealServiceSetting {
  id              String      @id @default(uuid())
  schoolId        String
  service         MealService
  allowedWeekdays Int[]
  isEnabled       Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  school School @relation(fields: [schoolId], references: [id])

  @@unique([id, schoolId])
  @@unique([schoolId, service])
}

/// Prix d'une journée de service, en vigueur à partir de `effectiveFrom` (jour de l'école).
/// Historisé : un nouveau tarif ne réécrit jamais le précédent.
model MealPrice {
  id            String      @id @default(uuid())
  schoolId      String
  service       MealService
  amount        Decimal     @db.Decimal(10, 2)
  effectiveFrom DateTime    @db.Date
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  school School @relation(fields: [schoolId], references: [id])

  @@unique([id, schoolId])
  @@unique([schoolId, service, effectiveFrom])
}

model Invitation {
  id          String     @id @default(cuid())
  schoolId    String
  email       String
  role        SchoolRole @default(PARENT)
  token       String     @unique
  locale      String     @default("fr") @db.VarChar(5)
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String
  familyId    String?
  personId    String?
  teacherId   String?
  createdAt   DateTime   @default(now())

  school    School   @relation(fields: [schoolId], references: [id])
  createdBy User     @relation(fields: [createdById], references: [id])
  family    Family?  @relation(fields: [familyId, schoolId], references: [id, schoolId], onDelete: Cascade)
  person    Person?  @relation(fields: [personId, schoolId], references: [id, schoolId], onDelete: Restrict)
  teacher   Teacher? @relation(fields: [teacherId, schoolId], references: [id, schoolId], onDelete: Restrict)

  @@index([email])
  @@index([token])
  @@index([familyId])
  @@index([personId])
  @@index([teacherId])
  @@index([schoolId])
}

model Passkey {
  id           String   @id @default(cuid())
  userId       String
  name         String   @db.VarChar(250)
  credentialId String   @unique
  publicKey    String   @db.Text
  counter      BigInt   @default(0)
  deviceType   String   @db.VarChar(32)
  backedUp     Boolean  @default(false)
  transports   String?  @db.VarChar(250)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Clé d'accès machine au serveur MCP, portée par un utilisateur sur une école.
///
/// La clé n'existe en base que sous forme de hachage SHA-256 : contrairement à
/// `Invitation.token`, elle est durable et donne le droit d'écrire.
///
/// `schoolId` est figé dans la clé plutôt que passé en argument d'outil : la portée est
/// ainsi établie avant tout appel, et le rayon d'une fuite se limite à une école.
///
/// Volontairement hors du garde tenant : c'est une table de découverte, lue par
/// `keyHash` avant qu'une école soit connue. `src/gateways/mcp-api-key-gateway.ts` en est
/// la seule frontière.
model McpApiKey {
  id         String    @id @default(uuid())
  schoolId   String
  userId     String
  name       String    @db.VarChar(80)
  prefix     String    @db.VarChar(16)
  keyHash    String    @unique @db.VarChar(64)
  lastUsedAt DateTime?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  // Sans `onDelete`, donc `Restrict` : la suppression d'un compte doit échouer plutôt
  // qu'effacer la trace de ses clés, comme pour `PaymentTransaction.initiatedBy`.
  user   User   @relation(fields: [userId], references: [id])

  @@unique([id, schoolId])
  @@index([schoolId])
  @@index([userId, schoolId])
}

/// Client OAuth enregistré dynamiquement (RFC 7591) : ChatGPT, ou tout client MCP qui
/// s'enregistre à la première connexion. Public — sans secret — et prouvé par PKCE.
///
/// Hors garde tenant : un client n'appartient à aucune école, c'est la connexion
/// (`McpOAuthGrant`) qui en choisit une. `src/gateways/mcp-oauth-client-gateway.ts` en est
/// la seule frontière.
model McpOAuthClient {
  id           String   @id @default(uuid())
  clientName   String   @db.VarChar(120)
  redirectUris String[]
  createdAt    DateTime @default(now())

  grants McpOAuthGrant[]
}

/// Connexion OAuth : un utilisateur a autorisé un client à administrer UNE école de ce
/// site. C'est l'objet que l'onglet « Clés API » liste et révoque ; les jetons en dérivent.
///
/// `resource` fige l'audience (l'URL `/api/mcp` du site émetteur) : un jeton émis ici n'a
/// pas d'audience ailleurs. `schoolId` est figé comme pour `McpApiKey`.
model McpOAuthGrant {
  id         String    @id @default(uuid())
  schoolId   String
  userId     String
  clientId   String
  clientName String    @db.VarChar(120)
  resource   String    @db.VarChar(255)
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  school School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  // `Restrict`, comme `McpApiKey.user` : la trace d'une connexion survit à son compte.
  user   User            @relation(fields: [userId], references: [id])
  client McpOAuthClient  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tokens McpOAuthToken[]

  @@unique([id, schoolId])
  @@index([schoolId])
  @@index([userId, schoolId])
  @@index([clientId])
}

enum McpOAuthTokenKind {
  CODE
  ACCESS
  REFRESH
}

/// Secret dérivé d'une connexion : code d'autorisation, jeton d'accès ou jeton de
/// rafraîchissement, en base sous forme de hachage SHA-256 uniquement.
///
/// `consumedAt` marque un code échangé ou un jeton de rafraîchissement tourné ; le
/// représenter à nouveau révoque la connexion entière. `codeChallenge` et `redirectUri`
/// ne sont portés que par un code, qui doit les revoir à l'échange.
///
/// Hors garde tenant : résolu par `tokenHash` avant que l'école soit connue.
/// `src/gateways/mcp-oauth-grant-gateway.ts` en est la seule frontière.
model McpOAuthToken {
  id            String            @id @default(uuid())
  grantId       String
  kind          McpOAuthTokenKind
  tokenHash     String            @unique @db.VarChar(64)
  prefix        String            @db.VarChar(16)
  codeChallenge String?           @db.VarChar(128)
  redirectUri   String?           @db.VarChar(512)
  expiresAt     DateTime
  consumedAt    DateTime?
  revokedAt     DateTime?
  createdAt     DateTime          @default(now())

  grant McpOAuthGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@index([grantId])
  @@index([expiresAt])
}

enum McpDraftStatus {
  PENDING
  COMMITTED
}

// Qui a proposé un brouillon : une clé MCP, un administrateur connecté via l'assistant
// d'inscription, ou une connexion OAuth. Les genres ne se croisent jamais — un brouillon
// n'est engageable que par le propriétaire du même genre et du même identifiant.
enum McpDraftOwnerKind {
  MCP_KEY
  ADMIN_SESSION
  OAUTH_GRANT
}

// Plan résolu d'une écriture MCP, entre le `preview_*` qui le calcule et le `commit_*` qui
// l'engage. Il porte le verrou à passage unique : `status` passe de PENDING à COMMITTED par
// un `updateMany` conditionnel, et `result` garde la réponse à rendre à un rejeu.
//
// `keyId`, `userId` et `grantId` sont exclusifs selon `ownerKind` ; la contrainte CHECK vit
// dans la migration, Prisma ne sachant pas l'exprimer.
model McpDraft {
  id          String            @id @default(uuid())
  schoolId    String
  ownerKind   McpDraftOwnerKind
  keyId       String?
  userId      String?
  grantId     String?
  tool        String            @db.VarChar(50)
  checksum    String            @db.VarChar(12)
  resolved    Json
  status      McpDraftStatus    @default(PENDING)
  result      Json?
  expiresAt   DateTime
  committedAt DateTime?
  createdAt   DateTime          @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([id, schoolId])
  @@index([schoolId])
  @@index([expiresAt])
}

/// Conversation de l'assistant IA, propre à un administrateur dans une école.
///
/// `messages` garde les messages au format de l'AI SDK, sans les photos : une image
/// envoyée devient un simple texte `[photo: nom]`. L'identifiant vient du navigateur,
/// qui le fixe à l'ouverture de la conversation.
model AiConversation {
  id        String   @id @db.Uuid
  schoolId  String
  userId    String
  title     String   @db.VarChar(120)
  messages  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([id, schoolId])
  @@index([schoolId, userId, updatedAt])
}

/// Événement de la vie de l'école : réunion, rentrée, sortie, vacances, fermeture,
/// festivité. Piloté par le réglage d'école `events_enabled`.
///
/// `allDay` impose une convention de stockage : minuit UTC, et un formatage forcé en
/// UTC (`formatEventDate`). Sans elle, une journée entière s'affiche la veille pour un
/// lecteur à l'ouest de Greenwich.
model Event {
  id                 String          @id @default(uuid())
  schoolId           String
  title              String          @db.VarChar(120)
  slug               String          @db.VarChar(140)
  summary            String?         @db.VarChar(280)
  description        String?         @db.Text
  category           EventCategory
  visibility         EventVisibility @default(MEMBERS)
  status             EventStatus     @default(DRAFT)
  allDay             Boolean         @default(true)
  startAt            DateTime
  endAt              DateTime?
  location           String?         @db.VarChar(250)
  // `null` : aucune annonce. Sinon le bandeau paraît J-n avant `startAt`.
  announceDaysBefore Int?
  isActive           Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  school School       @relation(fields: [schoolId], references: [id])
  images EventImage[]

  @@unique([id, schoolId])
  @@unique([schoolId, slug], where: { isActive: true })
  @@index([schoolId])
  @@index([schoolId, startAt])
  @@index([schoolId, status, visibility, startAt])
}

/// Image d'un événement. `position = 0` EST l'image principale : une colonne
/// `coverImageId` sur `Event` rendrait représentable une couverture pointant vers
/// l'image d'un autre événement.
///
/// Sans `isActive`, volontairement : le soft-delete ne filtre que la racine d'une
/// requête, donc une image archivée remonterait par `include`. Elle est supprimée pour
/// de bon ; l'objet laissé dans le bucket suit la règle déjà admise pour `branding/`.
model EventImage {
  id         String   @id @default(uuid())
  schoolId   String
  eventId    String
  storageKey String   @db.VarChar(250)
  alt        String?  @db.VarChar(250)
  position   Int      @default(0)
  createdAt  DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id])
  event  Event  @relation(fields: [eventId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@unique([id, schoolId])
  @@index([eventId])
  @@index([schoolId])
}

/// Membre du personnel qui mange à la cantine (#545). Liste propre à l'école, distincte des
/// enseignants. `mealExempt` : ses repas sont comptés mais jamais facturés.
/// Inscription d'un élève ou d'un membre du personnel à un service repas : exactement l'un des
/// deux (contrainte `MealAccount_owner_check`). Ligne verrouillée par toute mutation du compte.
model MealAccount {
  id        String      @id @default(uuid())
  schoolId  String
  studentId String?
  teacherId String?
  service   MealService
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  school      School           @relation(fields: [schoolId], references: [id])
  student     Student?         @relation(fields: [studentId, schoolId], references: [id, schoolId], onDelete: Cascade)
  teacher     Teacher?         @relation(fields: [teacherId, schoolId], references: [id, schoolId], onDelete: Restrict)
  schedules   MealSchedule[]
  adjustments MealAdjustment[]
  payments    MealPayment[]
  absences    MealAbsence[]

  @@unique([id, schoolId])
  @@unique([schoolId, studentId, service])
  @@unique([schoolId, teacherId, service])
  @@index([schoolId])
}

/// Segment daté de jours servis (R6). `endOn` nul : jusqu'à la fin de la période.
model MealSchedule {
  id        String    @id @default(uuid())
  schoolId  String
  accountId String
  periodId  String
  weekdays  Int[]
  startOn   DateTime  @db.Date
  endOn     DateTime? @db.Date
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  school  School      @relation(fields: [schoolId], references: [id])
  account MealAccount @relation(fields: [accountId, schoolId], references: [id, schoolId], onDelete: Cascade)
  period  Period      @relation(fields: [periodId, schoolId], references: [id, schoolId])

  @@unique([id, schoolId])
  @@index([accountId])
  @@index([periodId])
}

model MealAdjustment {
  id           String             @id @default(uuid())
  schoolId     String
  accountId    String
  kind         MealAdjustmentKind
  days         Int
  reason       String             @db.VarChar(250)
  recordedById String
  createdAt    DateTime           @default(now())

  school     School      @relation(fields: [schoolId], references: [id])
  account    MealAccount @relation(fields: [accountId, schoolId], references: [id, schoolId], onDelete: Cascade)
  recordedBy User        @relation("mealAdjustmentRecordedBy", fields: [recordedById], references: [id])

  @@unique([id, schoolId])
  @@index([accountId])
}

/// Jour servi que l'enfant n'a pas mangé (R7) : il n'est pas consommé, la couverture glisse.
/// L'auteur peut partir : l'absence reste, sans lui.
model MealAbsence {
  id             String   @id @default(uuid())
  schoolId       String
  accountId      String
  date           DateTime @db.Date
  recordedById   String?
  /// Posée par les appels validés du jour, qui la retirent ; jamais une absence saisie à la main.
  fromAttendance Boolean  @default(false)
  createdAt      DateTime @default(now())

  school     School      @relation(fields: [schoolId], references: [id])
  account    MealAccount @relation(fields: [accountId, schoolId], references: [id, schoolId], onDelete: Cascade)
  recordedBy User?       @relation("mealAbsenceRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([id, schoolId])
  @@unique([schoolId, accountId, date])
  @@index([accountId])
}

/// Un versement au guichet : un numéro, un mode, un total, N lignes repas et écolage d'une même
/// famille (§14), ou la cantine d'un membre du personnel : exactement l'un des deux payeurs
/// (contrainte `Receipt_payer_check`). La clé d'idempotence rend un double envoi inoffensif.
model Receipt {
  id             String        @id @default(uuid())
  schoolId       String
  familyId       String?
  teacherId      String?
  number         Int
  total          Decimal       @db.Decimal(10, 2)
  method         PaymentMethod
  reference      String?       @db.VarChar(250)
  paidAt         DateTime
  /// Nul pour un paiement en ligne : aucun membre de l'école ne l'a saisi.
  recordedById   String?
  idempotencyKey String        @db.VarChar(64)
  requestHash    String        @db.VarChar(64)
  cancelledAt    DateTime?
  cancelledById  String?
  cancelReason   String?       @db.VarChar(250)
  /// Jeton du lien public de lecture, créé au premier partage ; le lien meurt avec l'annulation.
  shareToken     String?       @unique @db.VarChar(64)
  createdAt      DateTime      @default(now())

  school            School             @relation(fields: [schoolId], references: [id])
  family            Family?            @relation(fields: [familyId, schoolId], references: [id, schoolId], onDelete: Restrict)
  teacher           Teacher?           @relation(fields: [teacherId, schoolId], references: [id, schoolId], onDelete: Restrict)
  recordedBy        User?              @relation("receiptRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  cancelledBy       User?              @relation("receiptCancelledBy", fields: [cancelledById], references: [id])
  mealPayments      MealPayment[]
  childcarePayments ChildcarePayment[]
  payments          Payment[]

  @@unique([id, schoolId])
  @@unique([schoolId, number])
  @@unique([schoolId, idempotencyKey])
  @@index([familyId])
  @@index([teacherId])
}

/// Prochain numéro de reçu de l'école, jamais remis à zéro.
model ReceiptCounter {
  schoolId String @id
  next     Int    @default(1)

  school School @relation(fields: [schoolId], references: [id])
}

/// Ligne repas d'un reçu (R1) : le tarif est figé, la couverture au moment du reçu n'est qu'une
/// copie d'affichage, jamais relue en calcul.
model MealPayment {
  id                   String    @id @default(uuid())
  schoolId             String
  receiptId            String
  accountId            String
  amount               Decimal   @db.Decimal(10, 2)
  unitPrice            Decimal   @db.Decimal(10, 2)
  daysAdded            Int
  paidThroughAtReceipt DateTime? @db.Date
  creditAtReceipt      Decimal   @db.Decimal(10, 2)
  createdAt            DateTime  @default(now())

  school  School      @relation(fields: [schoolId], references: [id])
  receipt Receipt     @relation(fields: [receiptId, schoolId], references: [id, schoolId], onDelete: Cascade)
  account MealAccount @relation(fields: [accountId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@unique([id, schoolId])
  @@index([receiptId])
  @@index([accountId])
}

/// Garderie d'un enfant (#534) : un forfait mensuel, indépendant des comptes repas et de
/// l'inscription scolaire. `startMonth` et `endMonth` sont le 1er du mois ; `endMonth` nul : ouvert.
model ChildcareSubscription {
  id                  String    @id @default(uuid())
  schoolId            String
  studentId           String
  monthlyAmount       Decimal   @db.Decimal(10, 2)
  startMonth          DateTime  @db.Date
  endMonth            DateTime? @db.Date
  /// Reprise : mois réglés avant l'application, jusqu'à ce mois inclus. Aucun reçu ni encaissement.
  openingPaidThrough  DateTime? @db.Date
  openingReason       String?   @db.VarChar(250)
  openingRecordedById String?
  openingRecordedAt   DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  school            School            @relation(fields: [schoolId], references: [id])
  student           Student           @relation(fields: [studentId, schoolId], references: [id, schoolId], onDelete: Cascade)
  openingRecordedBy User?             @relation("childcareOpeningRecordedBy", fields: [openingRecordedById], references: [id], onDelete: SetNull)
  charges           ChildcareCharge[]

  @@unique([id, schoolId])
  @@unique([schoolId, studentId])
  @@index([studentId])
}

/// Mois facturé à un enfant, créé seulement par une facturation explicite. Le montant est figé :
/// changer le tarif ne reprice pas un mois facturé. Une ligne par mois : rejouer ne double rien.
model ChildcareCharge {
  id             String    @id @default(uuid())
  schoolId       String
  subscriptionId String
  month          DateTime  @db.Date
  amount         Decimal   @db.Decimal(10, 2)
  recordedById   String?
  cancelledAt    DateTime?
  cancelledById  String?
  cancelReason   String?   @db.VarChar(250)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  school       School                @relation(fields: [schoolId], references: [id])
  subscription ChildcareSubscription @relation(fields: [subscriptionId, schoolId], references: [id, schoolId], onDelete: Cascade)
  recordedBy   User?                 @relation("childcareChargeRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  cancelledBy  User?                 @relation("childcareChargeCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  payments     ChildcarePayment[]

  @@unique([id, schoolId])
  @@unique([schoolId, subscriptionId, month])
  @@index([subscriptionId])
}

/// Ligne garderie d'un reçu : un versement, entier ou partiel, sur un mois facturé. Elle cesse de
/// compter quand son reçu est annulé.
model ChildcarePayment {
  id        String   @id @default(uuid())
  schoolId  String
  receiptId String
  chargeId  String
  amount    Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  school  School          @relation(fields: [schoolId], references: [id])
  receipt Receipt         @relation(fields: [receiptId, schoolId], references: [id, schoolId], onDelete: Cascade)
  charge  ChildcareCharge @relation(fields: [chargeId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@unique([id, schoolId])
  @@index([receiptId])
  @@index([chargeId])
}
