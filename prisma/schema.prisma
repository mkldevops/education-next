generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum Sex {
  MALE
  FEMALE
}

enum RelationType {
  PARENT
  TUTOR
  GRANDPARENT
  SIBLING
  OTHER
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  CHECK
  STRIPE
}

enum PaymentProvider {
  STRIPE
}

enum PaymentTransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
  EXPIRED
  REFUNDED
}

enum ConfigValueType {
  TEXT
  NUMBER
  BOOLEAN
  COLOR
}

// Rôle porté par une appartenance à une école. SUPER_ADMIN n'en fait pas partie :
// c'est un niveau plateforme, matérialisé par User.isSuperAdmin.
enum SchoolRole {
  ADMIN
  PARENT
}

// ─── Tenant ─────────────────────────────────────────────────────────────────

model School {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(250)
  slug      String   @unique @db.VarChar(80)
  address   String?  @db.VarChar(250)
  postCode  String?  @db.VarChar(10)
  city      String?  @db.VarChar(250)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members             SchoolMember[]
  families            Family[]
  userFamilies        UserFamily[]
  persons             Person[]
  familyPersons       FamilyPerson[]
  students            Student[]
  phoneNumbers        PhoneNumber[]
  configs             Config[]
  levels              Level[]
  periods             Period[]
  classPeriods        ClassPeriod[]
  enrollments         Enrollment[]
  classAssignments    ClassAssignment[]
  payments            Payment[]
  paymentTransactions PaymentTransaction[]
  plans               Plan[]
  invitations         Invitation[]
  teachers            Teacher[]
  classPeriodTeachers ClassPeriodTeacher[]
  teacherExpenses     TeacherExpense[]
  mcpApiKeys          McpApiKey[]
  mcpDrafts           McpDraft[]
}

// Hors garde tenant par construction : le contexte doit lire les appartenances
// par userId avant de connaître une école. Accès via school-member-gateway.
model SchoolMember {
  userId    String
  schoolId  String
  role      SchoolRole
  createdAt DateTime   @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userFamilies UserFamily[]

  @@id([userId, schoolId])
  @@unique([userId, schoolId])
  @@index([schoolId, role])
}

// ─── Better Auth Models ─────────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  isSuperAdmin  Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions            Session[]
  accounts            Account[]
  families            UserFamily[]
  createdFamilies     Family[]             @relation("createdBy")
  createdInvitations  Invitation[]
  paymentTransactions PaymentTransaction[] @relation("paymentInitiatedBy")
  passkeys            Passkey[]
  schoolMemberships   SchoolMember[]
  mcpApiKeys          McpApiKey[]
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  issuer                String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String   @unique
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ─── Domain Models ──────────────────────────────────────────────────────────

model Family {
  id                    String   @id @default(uuid())
  schoolId              String
  name                  String   @db.VarChar(50)
  emergencyContactName  String?  @db.VarChar(250)
  emergencyContactPhone String?  @db.VarChar(20)
  authorizedPickup      String?  @db.Text
  createdById           String
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  school              School               @relation(fields: [schoolId], references: [id])
  createdBy           User                 @relation("createdBy", fields: [createdById], references: [id])
  users               UserFamily[]
  persons             FamilyPerson[]
  payments            Payment[]
  paymentTransactions PaymentTransaction[]
  invitations         Invitation[]

  @@unique([id, schoolId])
  @@index([createdById])
  @@index([schoolId])
}

model UserFamily {
  userId   String
  familyId String
  schoolId String

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School       @relation(fields: [schoolId], references: [id])
  family Family       @relation(fields: [familyId, schoolId], references: [id, schoolId], onDelete: Cascade)
  member SchoolMember @relation(fields: [userId, schoolId], references: [userId, schoolId], onDelete: Cascade)

  @@id([userId, familyId])
  @@index([familyId])
  @@index([schoolId])
}

model Person {
  id        String   @id @default(uuid())
  schoolId  String
  name      String   @db.VarChar(250)
  lastname  String   @db.VarChar(250)
  sex       Sex
  email     String?  @db.VarChar(250)
  address   String?  @db.VarChar(250)
  postCode  String?  @db.VarChar(10)
  city      String?  @db.VarChar(250)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school       School         @relation(fields: [schoolId], references: [id])
  phoneNumbers PhoneNumber[]
  families     FamilyPerson[]
  student      Student?
  invitations  Invitation[]

  @@unique([id, schoolId])
  @@index([schoolId])
}

model FamilyPerson {
  familyId     String
  personId     String
  schoolId     String
  relationType RelationType

  school School @relation(fields: [schoolId], references: [id])
  family Family @relation(fields: [familyId, schoolId], references: [id, schoolId], onDelete: Cascade)
  person Person @relation(fields: [personId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@id([familyId, personId])
  @@index([personId])
  @@index([schoolId])
}

model Student {
  id                 String   @id @default(uuid())
  schoolId           String
  personId           String
  birthday           DateTime
  birthplace         String?  @db.VarChar(250)
  previousSchool     String?  @db.VarChar(250)
  healthNotes        String?  @db.Text
  languagesAtHome    Json     @default("[]")
  snackAuthorization Boolean  @default(false)
  allergies          String?  @db.VarChar(250)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  school      School       @relation(fields: [schoolId], references: [id])
  person      Person       @relation(fields: [personId, schoolId], references: [id, schoolId], onDelete: Cascade)
  enrollments Enrollment[]

  @@unique([id, schoolId])
  @@unique([personId, schoolId])
  @@index([schoolId])
}

model PhoneNumber {
  id          String   @id @default(uuid())
  schoolId    String
  personId    String
  phoneNumber String   @db.VarChar(20)
  channels    Json     @default("[]")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id])
  person Person @relation(fields: [personId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@index([personId])
  @@index([schoolId])
}

model Config {
  id        String          @id @default(uuid())
  schoolId  String
  name      String          @db.VarChar(250)
  value     String          @db.Text
  valueType ConfigValueType
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  school School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, name], where: { isActive: true })
  @@index([name])
  @@index([schoolId])
}

// Réglage de la plateforme entière, sans école. Volontairement distinct de `Config` :
// celui-ci porte un `schoolId` obligatoire et appartient au garde tenant, donc une
// lecture racine plateforme y lèverait `TenantScopeError`. Pas de `isActive` non plus —
// un réglage plateforme n'a pas de parcours d'archivage, et un `@unique` total sur
// `name` bloquerait la recréation d'un réglage archivé homonyme.
model PlatformSetting {
  id        String          @id @default(uuid())
  name      String          @unique @db.VarChar(250)
  value     String          @db.Text
  valueType ConfigValueType
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model Level {
  id          String   @id @default(uuid())
  schoolId    String
  name        String   @db.VarChar(250)
  nextLevelId String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school        School        @relation(fields: [schoolId], references: [id])
  nextLevel     Level?        @relation("levelProgression", fields: [nextLevelId, schoolId], references: [id, schoolId], onDelete: Restrict)
  previousLevel Level?        @relation("levelProgression")
  classPeriods  ClassPeriod[]

  @@unique([id, schoolId])
  @@unique([nextLevelId, schoolId])
  @@unique([schoolId, name], where: { isActive: true })
  @@index([schoolId])
}

model Period {
  id        String   @id @default(uuid())
  schoolId  String
  name      String   @db.VarChar(50)
  startAt   DateTime
  endAt     DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school       School        @relation(fields: [schoolId], references: [id])
  classPeriods ClassPeriod[]

  @@unique([id, schoolId])
  @@unique([schoolId, name], where: { isActive: true })
  @@index([schoolId])
}

model ClassPeriod {
  id        String   @id @default(uuid())
  schoolId  String
  name      String   @db.VarChar(250)
  capacity  Int
  levelId   String
  periodId  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school           School               @relation(fields: [schoolId], references: [id])
  level            Level                @relation(fields: [levelId, schoolId], references: [id, schoolId], onDelete: Restrict)
  period           Period               @relation(fields: [periodId, schoolId], references: [id, schoolId], onDelete: Restrict)
  classAssignments ClassAssignment[]
  teachers         ClassPeriodTeacher[]

  @@unique([id, schoolId])
  @@index([levelId])
  @@index([periodId])
  @@index([schoolId])
}

model Teacher {
  id        String   @id @default(uuid())
  schoolId  String
  firstName String   @db.VarChar(250)
  lastName  String   @db.VarChar(250)
  email     String?  @db.VarChar(250)
  phone     String?  @db.VarChar(20)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school       School               @relation(fields: [schoolId], references: [id])
  classPeriods ClassPeriodTeacher[]
  expenses     TeacherExpense[]

  @@unique([id, schoolId])
  @@index([schoolId])
  @@index([schoolId, lastName, firstName])
}

model ClassPeriodTeacher {
  schoolId      String
  classPeriodId String
  teacherId     String
  assignedAt    DateTime @default(now())

  school      School      @relation(fields: [schoolId], references: [id])
  classPeriod ClassPeriod @relation(fields: [classPeriodId, schoolId], references: [id, schoolId], onDelete: Cascade)
  teacher     Teacher     @relation(fields: [teacherId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@id([classPeriodId, teacherId])
  @@index([teacherId])
  @@index([schoolId])
}

model TeacherExpense {
  id          String    @id @default(uuid())
  schoolId    String
  teacherId   String
  amount      Decimal   @db.Decimal(10, 2)
  category    String    @db.VarChar(100)
  description String    @db.VarChar(250)
  requestedAt DateTime  @default(now())
  paidAt      DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  school  School  @relation(fields: [schoolId], references: [id])
  teacher Teacher @relation(fields: [teacherId, schoolId], references: [id, schoolId], onDelete: Restrict)

  @@unique([id, schoolId])
  @@index([teacherId])
  @@index([schoolId])
  @@index([requestedAt])
}

model Enrollment {
  id            String           @id @default(uuid())
  schoolId      String
  studentId     String
  planId        String
  status        EnrollmentStatus @default(PENDING)
  totalAmount   Decimal          @db.Decimal(10, 2)
  discount      Decimal          @default(0) @db.Decimal(10, 2)
  registeredAt  DateTime         @default(now())
  canLeaveAlone Boolean          @default(false)
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  school           School            @relation(fields: [schoolId], references: [id])
  student          Student           @relation(fields: [studentId, schoolId], references: [id, schoolId], onDelete: Restrict)
  plan             Plan              @relation(fields: [planId, schoolId], references: [id, schoolId], onDelete: Restrict)
  classAssignments ClassAssignment[]
  payments         Payment[]

  @@unique([id, schoolId])
  @@index([studentId])
  @@index([planId])
  @@index([status])
  @@index([schoolId])
}

model ClassAssignment {
  id            String    @id @default(uuid())
  schoolId      String
  enrollmentId  String
  classPeriodId String
  startAt       DateTime  @default(now())
  endAt         DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  school      School      @relation(fields: [schoolId], references: [id])
  enrollment  Enrollment  @relation(fields: [enrollmentId, schoolId], references: [id, schoolId], onDelete: Restrict)
  classPeriod ClassPeriod @relation(fields: [classPeriodId, schoolId], references: [id, schoolId], onDelete: Restrict)

  @@index([enrollmentId])
  @@index([classPeriodId])
  @@index([schoolId])
}

model Payment {
  id                   String        @id @default(uuid())
  schoolId             String
  familyId             String
  enrollmentId         String
  paymentTransactionId String?
  amount               Decimal       @db.Decimal(10, 2)
  method               PaymentMethod
  reference            String?       @db.VarChar(250)
  paidAt               DateTime
  cashedAt             DateTime?
  isActive             Boolean       @default(true)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  school             School              @relation(fields: [schoolId], references: [id])
  family             Family              @relation(fields: [familyId, schoolId], references: [id, schoolId], onDelete: Restrict)
  enrollment         Enrollment          @relation(fields: [enrollmentId, schoolId], references: [id, schoolId], onDelete: Restrict)
  paymentTransaction PaymentTransaction? @relation(fields: [paymentTransactionId, schoolId], references: [id, schoolId], onDelete: Restrict)

  @@index([familyId])
  @@index([enrollmentId])
  @@index([paymentTransactionId])
  @@index([schoolId])
}

model PaymentTransaction {
  id                String                   @id @default(uuid())
  schoolId          String
  familyId          String
  initiatedById     String
  amount            Decimal                  @db.Decimal(10, 2)
  currency          String                   @default("EUR") @db.VarChar(3)
  provider          PaymentProvider
  status            PaymentTransactionStatus @default(PENDING)
  providerSessionId String?                  @unique
  providerPaymentId String?                  @db.VarChar(250)
  succeededAt       DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  school      School                 @relation(fields: [schoolId], references: [id])
  family      Family                 @relation(fields: [familyId, schoolId], references: [id, schoolId], onDelete: Restrict)
  initiatedBy User                   @relation("paymentInitiatedBy", fields: [initiatedById], references: [id])
  allocations Payment[]
  events      PaymentProviderEvent[]

  @@unique([id, schoolId])
  @@index([familyId])
  @@index([initiatedById])
  @@index([status])
  @@index([schoolId])
}

// Non scopé volontairement : paymentTransactionId est nullable, un événement
// fournisseur orphelin n'a aucune école dérivable. Journal plateforme, écrit
// uniquement dans le chemin d'exception Stripe.
model PaymentProviderEvent {
  id                   String   @id @default(uuid())
  providerEventId      String   @unique
  type                 String   @db.VarChar(100)
  paymentTransactionId String?
  createdAt            DateTime @default(now())

  paymentTransaction PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id])

  @@index([paymentTransactionId])
}

model Plan {
  id        String   @id @default(uuid())
  schoolId  String
  name      String   @db.VarChar(50)
  amount    Decimal  @db.Decimal(10, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school      School       @relation(fields: [schoolId], references: [id])
  enrollments Enrollment[]

  @@unique([id, schoolId])
  @@unique([schoolId, name], where: { isActive: true })
  @@index([schoolId])
}

model Invitation {
  id          String     @id @default(cuid())
  schoolId    String
  email       String
  role        SchoolRole @default(PARENT)
  token       String     @unique
  locale      String     @default("fr") @db.VarChar(5)
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String
  familyId    String?
  personId    String?
  createdAt   DateTime   @default(now())

  school    School  @relation(fields: [schoolId], references: [id])
  createdBy User    @relation(fields: [createdById], references: [id])
  family    Family? @relation(fields: [familyId, schoolId], references: [id, schoolId], onDelete: Cascade)
  person    Person? @relation(fields: [personId, schoolId], references: [id, schoolId], onDelete: Restrict)

  @@index([email])
  @@index([token])
  @@index([familyId])
  @@index([personId])
  @@index([schoolId])
}

model Passkey {
  id           String   @id @default(cuid())
  userId       String
  name         String   @db.VarChar(250)
  credentialId String   @unique
  publicKey    String   @db.Text
  counter      BigInt   @default(0)
  deviceType   String   @db.VarChar(32)
  backedUp     Boolean  @default(false)
  transports   String?  @db.VarChar(250)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Clé d'accès machine au serveur MCP, portée par un utilisateur sur une école.
///
/// La clé n'existe en base que sous forme de hachage SHA-256 : contrairement à
/// `Invitation.token`, elle est durable et donne le droit d'écrire.
///
/// `schoolId` est figé dans la clé plutôt que passé en argument d'outil : la portée est
/// ainsi établie avant tout appel, et le rayon d'une fuite se limite à une école.
///
/// Volontairement hors du garde tenant : c'est une table de découverte, lue par
/// `keyHash` avant qu'une école soit connue. `src/gateways/mcp-api-key-gateway.ts` en est
/// la seule frontière.
model McpApiKey {
  id         String    @id @default(uuid())
  schoolId   String
  userId     String
  name       String    @db.VarChar(80)
  prefix     String    @db.VarChar(16)
  keyHash    String    @unique @db.VarChar(64)
  lastUsedAt DateTime?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([id, schoolId])
  @@index([schoolId])
  @@index([userId, schoolId])
}

enum McpDraftStatus {
  PENDING
  COMMITTED
}

// Plan résolu d'une écriture MCP, entre le `preview_*` qui le calcule et le `commit_*` qui
// l'engage. Il porte le verrou à passage unique : `status` passe de PENDING à COMMITTED par
// un `updateMany` conditionnel, et `result` garde la réponse à rendre à un rejeu.
model McpDraft {
  id          String         @id @default(uuid())
  schoolId    String
  keyId       String
  tool        String         @db.VarChar(50)
  checksum    String         @db.VarChar(12)
  resolved    Json
  status      McpDraftStatus @default(PENDING)
  result      Json?
  expiresAt   DateTime
  committedAt DateTime?
  createdAt   DateTime       @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([id, schoolId])
  @@index([schoolId])
  @@index([expiresAt])
}
