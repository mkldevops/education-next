{
  "name": "education-next",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "predev": "pnpm db:generate && docker compose up -d",
    "dev": "dotenv-cli -- next dev",
    "build": "next build",
    "build:prod": "prisma generate && prisma migrate deploy && next build",
    "start": "dotenv-cli -- next start",
    "start:prod": "prisma migrate deploy && dotenv-cli -- next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "type-check": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "knip": "knip",
    "db:start": "docker compose up -d",
    "db:stop": "docker compose down",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "dotenv-cli -- tsx prisma/seed.ts",
    "db:seed:demo": "dotenv-cli -- tsx prisma/seed-demo.ts",
    "db:seed:childcare": "dotenv-cli -- tsx prisma/seed-childcare.ts",
    "db:import-roster": "dotenv-cli -- tsx prisma/import-roster.ts",
    "db:import-meals": "dotenv-cli -- tsx prisma/import-meals.ts",
    "postinstall": "prisma generate",
    "lint:tw": "tailwind-canonical --check",
    "lint:tw:fix": "tailwind-canonical"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@prisma/client",
      "@prisma/engines",
      "@swc/core",
      "esbuild",
      "lefthook",
      "prisma",
      "sharp"
    ]
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.181",
    "@aws-sdk/client-s3": "^3.1173.0",
    "@base-ui/react": "^1.9.0",
    "@modelcontextprotocol/ext-apps": "2.0.4",
    "@modelcontextprotocol/server": "^2.4.0",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@sentry/nextjs": "^11.15.0",
    "@shadcn/react": "^0.3.1",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.1.0",
    "@tanstack/react-table": "^9.2.4",
    "ai": "^7.0.177",
    "better-auth": "^1.7.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.77.0",
    "next": "^16.4.6",
    "next-intl": "^4.15.3",
    "pg": "^8.23.1",
    "qrcode": "1.5.4",
    "react": "^19.3.1",
    "react-colorful": "5.8.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "read-excel-file": "9.3.20",
    "remark-gfm": "^4.0.1",
    "resend": "^6.39.0",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "stripe": "^23.2.0",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "19.0.0-beta-af1b7da-20250417",
    "dotenv": "18.0.10",
    "dotenv-cli": "^11.1.0",
    "dotenv-expand": "^1000.0.0",
    "jsdom": "^31.0.1",
    "knip": "^6.46.1",
    "lefthook": "^2.2.2",
    "mysql2": "^3.24.6",
    "postcss": "^8.5.33",
    "prisma": "^7.10.1",
    "tailwind-canonical": "^0.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
