{
  "name": "education-next",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "predev": "pnpm db:generate && docker compose up -d",
    "dev": "dotenv -- next dev",
    "build": "next build",
    "build:prod": "prisma generate && prisma migrate deploy && next build",
    "start": "dotenv -- next start",
    "start:prod": "prisma migrate deploy && dotenv -- next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "type-check": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "knip": "knip",
    "prepare": "husky",
    "db:start": "docker compose up -d",
    "db:stop": "docker compose down",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "dotenv -- tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@prisma/client",
      "@prisma/engines",
      "@swc/core",
      "esbuild",
      "prisma",
      "sharp"
    ]
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,json,css,md}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.117",
    "@aws-sdk/client-s3": "^3.1138.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "@tanstack/react-table": "^8.21.3",
    "ai": "^7.0.114",
    "better-auth": "^1.7.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.47.0",
    "next": "^16.3.6",
    "next-intl": "^4.14.6",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-colorful": "5.8.1",
    "react-dom": "^19.3.0",
    "resend": "^6.28.1",
    "sharp": "^0.35.4",
    "sonner": "^2.0.8",
    "stripe": "^22.6.2",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.9.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "19.0.0-beta-af1b7da-20250417",
    "dotenv": "17.4.2",
    "dotenv-cli": "^11.0.0",
    "dotenv-expand": "^12.0.3",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "knip": "^6.34.0",
    "lint-staged": "^16.4.0",
    "mysql2": "^3.24.2",
    "postcss": "^8.5.26",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
