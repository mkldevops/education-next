{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["app/**/*.{ts,tsx}", "src/features/**/index.ts", "src/i18n/*.ts", "src/lib/auth.ts"],
  "project": ["src/**/*.{ts,tsx}"],
  "ignore": [
    "src/components/ui/**",
    "src/use-cases/enrollments/list-enrollments.ts",
    "src/use-cases/families/list-families.ts",
    "src/use-cases/payments/list-payments.ts",
    "src/use-cases/students/list-students.ts",
    "src/config/email.ts",
    "src/domain/index.ts",
    "src/gateways/email/**",
    "src/gateways/index.ts",
    "src/lib/email.ts",
    "src/lib/theme.ts",
    "src/shared/index.ts",
    "src/types/email.ts",
    "src/use-cases/index.ts"
  ],
  "ignoreDependencies": ["tailwindcss"]
}
